# Docker Compose (used by docker-compose.prod.yml)
POSTGRES_DB=dailycook
POSTGRES_USER=dailycook_user
POSTGRES_PASSWORD=change-me

# Backend
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Firebase / Google auth (optional)
FIREBASE_SA_BASE64=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.dailycook.io.vn/auth/google/callback

# Mailjet (optional)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@dailycook.com
MAILJET_FROM_NAME=DailyCook
