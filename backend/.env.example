PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/dailycook?schema=public

# Firebase Admin (optional)
# Base64-encoded Firebase service account JSON
FIREBASE_SA_BASE64=
FIREBASE_PROJECT_ID=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AI
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailjet (optional)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=noreply@dailycook.com
MAILJET_FROM_NAME=DailyCook
